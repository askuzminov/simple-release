{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020"],
    "types": ["node"],
    "strict": true,
    "allowJs": true,
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "preserveSymlinks": false,
    "sourceMap": true,
    "outDir": "./dist/cjs/"
  },
  "include": ["src", "tests"]
}
